# Copy to api/.env for local development (`npm run dev` loads it).
DATABASE_URL=postgres://scannerroom_api:scannerroom@127.0.0.1:5432/scannerroom
# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=change-me-change-me-change-me-change-me
# The Vite dev server, which proxies /api to this API.
PUBLIC_URL=http://localhost:5173
PORT=3002

# ORCID sandbox client (https://sandbox.orcid.org/developer-tools); production uses https://orcid.org.
ORCID_ISSUER=https://sandbox.orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Google OAuth client, type "Web application", redirect http://localhost:5173/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated provider:subject entries, e.g. orcid:0000-0002-1825-0097,google:1234567890
ADMIN_IDENTITIES=
