{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["src/**/*", "scripts/**/*", "test/**/*", "drizzle.config.ts", "vitest.config.ts"],
  "compilerOptions": {
    // Run directly by Node's native type stripping: no build step, so only
    // erasable syntax and explicit .ts import extensions.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Referenced by the root tsconfig, so `npm run type-check` covers the API.
    "composite": true,
    "types": ["node"],

    // Same strictness as the front end.
    "strict": true,
    "noUncheckedIndexedAccess": true,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo"
  }
}
